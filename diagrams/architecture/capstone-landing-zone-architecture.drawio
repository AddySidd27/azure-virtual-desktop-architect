<mxfile host="app.diagrams.net" agent="azure-virtual-desktop-architect">
  <diagram name="Capstone Part B Landing Zone" id="capstoneb">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" page="1" pageWidth="1500" pageHeight="870" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Northwind Enterprise Azure Landing Zone: architecture at a glance" style="text;fontSize=20;fontStyle=1;fontColor=#243A5E;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1100" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="sub" value="Capstone Part B | Solid = built in this part | Dashed = named, reserved, not yet built (Part E)" style="text;fontSize=12;fontColor=#605E5C;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="55" width="1100" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="root" value="Tenant Root -&gt; Northwind (Intermediate Root)&#10;One governed hierarchy for the whole enterprise" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#243A5E;fontSize=13;fontColor=#243A5E;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="560" y="100" width="380" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="zPlatform" value="PLATFORM - ENTERPRISE-WIDE CAPABILITIES (BUILT)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FC;strokeColor=#0078D4;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;fontSize=12;fontStyle=1;fontColor=#0078D4;" vertex="1" parent="1">
          <mxGeometry x="60" y="210" width="660" height="320" as="geometry"/>
        </mxCell>
        <mxCell id="identity" value="Identity&#10;sub-northwind-identity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#243A5E;fontSize=13;fontColor=#243A5E;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="90" y="250" width="190" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="mgmt" value="Management&#10;sub-northwind-management" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#243A5E;fontSize=13;fontColor=#243A5E;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="300" y="250" width="190" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="conn" value="Connectivity&#10;sub-northwind-connectivity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#243A5E;fontSize=13;fontColor=#243A5E;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="510" y="250" width="190" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="gov" value="Enterprise-wide governance&#10;Azure Policy (tags, regions, diagnostics), PIM/RBAC, FinOps, security baseline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#107C10;fontSize=13;fontColor=#107C10;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="90" y="365" width="610" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="decom" value="Decommissioned&#10;governance hygiene - Part B, section 4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#605E5C;fontSize=13;fontColor=#605E5C;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="90" y="440" width="300" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="zLZ" value="LANDING ZONES - WORKLOAD LANDING ZONES" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3FAF3;strokeColor=#107C10;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;fontSize=12;fontStyle=1;fontColor=#107C10;" vertex="1" parent="1">
          <mxGeometry x="780" y="210" width="660" height="320" as="geometry"/>
        </mxCell>
        <mxCell id="corp" value="Corp (built, reserved, empty)&#10;Workloads requiring hybrid connectivity land here" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#107C10;fontSize=13;fontColor=#107C10;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="810" y="250" width="600" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="avdlz" value="FUTURE: AVD Landing Zone&#10;Part E - not yet built - sub-northwind-avd-prod / -nonprod&#10;Five host pools x two regions, designed in the Master Plan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#B77300;fontSize=13;fontColor=#B77300;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;dashed=1;dashPattern=6 4;" vertex="1" parent="1">
          <mxGeometry x="810" y="320" width="600" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="notbuilt" value="NOT built&#10;Online landing zone, Sandbox MG - no stated requirement (section 4)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#605E5C;fontSize=13;fontColor=#605E5C;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="810" y="440" width="600" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="consumes, does not own" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#B77300;strokeWidth=2;endArrow=blockThin;endFill=1;fontColor=#B77300;" edge="1" parent="1" source="avdlz" target="gov">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="zNotes" value="HOW TO READ THIS IN 60 SECONDS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#1F5B96;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;fontSize=12;fontStyle=1;fontColor=#1F5B96;" vertex="1" parent="1">
          <mxGeometry x="40" y="575" width="1420" height="255" as="geometry"/>
        </mxCell>
        <mxCell id="f0" value="1  Platform (Identity, Management, Connectivity) is built now, in this part: three real subscriptions, governed centrally." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#243A5E;fontSize=11;fontColor=#243A5E;verticalAlign=middle;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="615" width="1380" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="f1" value="2  The AVD Landing Zone does not exist yet. It is named, reserved, and dashed on purpose - Part E builds it, consuming this platform, not duplicating it." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B77300;fontSize=11;fontColor=#B77300;verticalAlign=middle;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="655" width="1380" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="f2" value="3  Every box on this diagram traces to a specific Part A requirement - nothing here is a reference-architecture default with no stated Northwind reason." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#243A5E;fontSize=11;fontColor=#243A5E;verticalAlign=middle;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="695" width="1380" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="f3" value="4  Online landing zone and Sandbox management group are deliberately absent - see Part B section 4 for the reasoning, not an oversight." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#605E5C;fontSize=11;fontColor=#605E5C;verticalAlign=middle;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="735" width="1380" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="f4" value="5  When AVD is built, it will not own its own identity or network - it authenticates against Platform/Identity and rides Platform/Connectivity's hub." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#243A5E;fontSize=11;fontColor=#243A5E;verticalAlign=middle;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="775" width="1380" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="foot" value="Original architecture diagram created for this capstone. Not a Microsoft diagram. Verified against terraform/capstone-northwind/platform/ and Part B, August 2026. Self-contained, no remote icon dependency." style="text;fontSize=10;fontColor=#605E5C;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="845" width="1300" height="20" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
