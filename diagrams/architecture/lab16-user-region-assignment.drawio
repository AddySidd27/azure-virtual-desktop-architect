<mxfile host="app.diagrams.net" agent="azure-virtual-desktop-architect">
  <diagram name="Lab 16 region assignment" id="lab16">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" page="1" pageWidth="1500" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Lab 16 - user-to-region assignment" style="text;fontSize=20;fontStyle=1;fontColor=#243A5E;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="sub" value="Lab 16 | Matches terraform/lab16-region-assignment exactly | non-overlapping group membership prevents the Lab 15 lock-violation failure" style="text;fontSize=12;fontColor=#605E5C;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="55" width="1200" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="zEus2" value="EASTUS2 GROUPS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FC;strokeColor=#0078D4;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;fontSize=11;fontStyle=1;fontColor=#0078D4;" vertex="1" parent="1">
