        </mxCell>
        <mxCell id="g1" value="grp-avdlab-finance-eus2&#10;Desktop Virtualization User" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#243A5E;fontSize=11;fontColor=#243A5E;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="70" y="140" width="600" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="g2" value="grp-avdlab-support-eus2&#10;Desktop Virtualization User" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#243A5E;fontSize=11;fontColor=#243A5E;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="70" y="200" width="600" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="a1" value="ag-desktop-lab-eus2-01&#10;eastus2 application group (Lab 7)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#605E5C;fontSize=11;fontColor=#243A5E;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="70" y="260" width="600" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="zCus" value="CENTRALUS GROUPS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3FAF3;strokeColor=#107C10;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;fontSize=11;fontStyle=1;fontColor=#107C10;" vertex="1" parent="1">
          <mxGeometry x="780" y="100" width="660" height="260" as="geometry"/>
        </mxCell>
        <mxCell id="g3" value="grp-avdlab-finance-cus&#10;Desktop Virtualization User" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#243A5E;fontSize=11;fontColor=#243A5E;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="810" y="140" width="600" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="g4" value="grp-avdlab-support-cus&#10;Desktop Virtualization User" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#243A5E;fontSize=11;fontColor=#243A5E;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="810" y="200" width="600" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="a2" value="ag-desktop-lab-cus-01&#10;centralus application group (Lab 14)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#605E5C;fontSize=11;fontColor=#243A5E;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="810" y="260" width="600" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="zFlow" value="FLOWS AND DESIGN NOTES" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#1F5B96;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;fontSize=11;fontStyle=1;fontColor=#1F5B96;" vertex="1" parent="1">
          <mxGeometry x="40" y="400" width="1400" height="255" as="geometry"/>
        </mxCell>
        <mxCell id="f0" value="1  Each population gets TWO groups, one per region - never one shared group spanning both" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#243A5E;fontSize=11;fontColor=#243A5E;verticalAlign=middle;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="440" width="1380" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="f1" value="2  grp-avdlab-finance-eus2 scopes ONLY to ag-desktop-lab-eus2-01 - it has no role assignment on the centralus application group at all" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#243A5E;fontSize=11;fontColor=#243A5E;verticalAlign=middle;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="480" width="1380" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="f2" value="3  A finance user is placed in grp-avdlab-finance-eus2 OR grp-avdlab-finance-cus, never both - this is a manual/HR decision, not automated by this lab" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#243A5E;fontSize=11;fontColor=#243A5E;verticalAlign=middle;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="520" width="1380" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="f3" value="4  This is the control that prevents Lab 15's ERROR_LOCK_VIOLATION: a user simply cannot reach both regions' desktops at once" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B77300;fontSize=11;fontColor=#B77300;verticalAlign=middle;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="560" width="1380" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="f4" value="5  Moving a user between regions is a deliberate, documented group-membership change, not a runtime routing decision" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#243A5E;fontSize=11;fontColor=#243A5E;verticalAlign=middle;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="600" width="1380" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="foot" value="Original architecture diagram created for this book. Not a Microsoft diagram. Verified against terraform/lab16-region-assignment, August 2026. Self-contained shapes, no remote icon dependency." style="text;fontSize=10;fontColor=#605E5C;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="675" width="1200" height="20" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
