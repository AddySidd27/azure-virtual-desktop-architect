        </mxCell>
        <mxCell id="f2" value="3  Emergency Surge (300) -&gt; Surge Pool, manual trigger only (not part of the automatic schedule)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B77300;fontSize=11;fontColor=#B77300;verticalAlign=middle;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="560" width="1060" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="f3" value="4  Ramp-up, Peak, Ramp-down -&gt; Shift Pool (0 to 120 hosts, the pool that actually flexes)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#243A5E;fontSize=11;fontColor=#243A5E;verticalAlign=middle;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="600" width="1060" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="f4" value="5  Off-peak -&gt; Core Pool (25 to 30 hosts, the floor that never goes to zero)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#243A5E;fontSize=11;fontColor=#243A5E;verticalAlign=middle;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="640" width="1060" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="f5" value="6  Core Pool and Shift Pool share the same workspace and application groups (users see one desktop, not two pools)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#243A5E;fontSize=11;fontColor=#243A5E;verticalAlign=middle;align=left;spacingLeft=10;" vertex="1" parent="1">
