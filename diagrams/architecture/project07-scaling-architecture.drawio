        <mxCell id="f0" value="1  Shift 1 (520) and Shift 2 (610) demand -&gt; Ramp-up" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#243A5E;fontSize=11;fontColor=#243A5E;verticalAlign=middle;align=left;spacingLeft=10;" vertex="1" parent="1">
