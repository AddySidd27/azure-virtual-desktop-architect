        </mxCell>
        <mxCell id="f1" value="2  Shift 3 (180, lowest) demand -&gt; Off-peak directly" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#243A5E;fontSize=11;fontColor=#243A5E;verticalAlign=middle;align=left;spacingLeft=10;" vertex="1" parent="1">
