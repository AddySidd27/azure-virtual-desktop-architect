<mxfile host="app.diagrams.net" agent="azure-virtual-desktop-architect">
  <diagram name="Lab 18 regional monitoring" id="lab18">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" page="1" pageWidth="1500" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Lab 18 - regional monitoring topology" style="text;fontSize=20;fontStyle=1;fontColor=#243A5E;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="sub" value="Lab 18 | Matches terraform/lab18-regional-security-monitoring exactly | separate workspaces, one dashboard on top" style="text;fontSize=12;fontColor=#605E5C;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="55" width="1200" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="zEus2" value="EASTUS2 (LAB 10, EXISTING)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FC;strokeColor=#0078D4;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;fontSize=11;fontStyle=1;fontColor=#0078D4;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="660" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="w1" value="log-avd-lab-eus2-01&#10;Log Analytics workspace" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#243A5E;fontSize=11;fontColor=#243A5E;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="70" y="140" width="600" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="d1" value="diag-hostpool&#10;Checkpoint, Error, Management, Connection, HostRegistration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#243A5E;fontSize=11;fontColor=#243A5E;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="70" y="200" width="600" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="zCus" value="CENTRALUS (LAB 18, NEW)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3FAF3;strokeColor=#107C10;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;fontSize=11;fontStyle=1;fontColor=#107C10;" vertex="1" parent="1">
          <mxGeometry x="780" y="100" width="660" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="w2" value="log-avd-lab-cus-01&#10;Log Analytics workspace" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#243A5E;fontSize=11;fontColor=#243A5E;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="810" y="140" width="600" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="d2" value="diag-hostpool&#10;Checkpoint, Error, Management, Connection, HostRegistration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#243A5E;fontSize=11;fontColor=#243A5E;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="810" y="200" width="600" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="zDash" value="AZURE WORKBOOK - CROSS-WORKSPACE KQL QUERY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#1F5B96;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;fontSize=11;fontStyle=1;fontColor=#1F5B96;" vertex="1" parent="1">
          <mxGeometry x="300" y="330" width="900" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="dash" value="One dashboard, built ON TOP of both workspaces&#10;query layer aggregates, data layer stays isolated" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#243A5E;fontSize=11;fontColor=#243A5E;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="330" y="365" width="840" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="zFlow" value="FLOWS AND DESIGN NOTES" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#1F5B96;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;fontSize=11;fontStyle=1;fontColor=#1F5B96;" vertex="1" parent="1">
          <mxGeometry x="40" y="460" width="1400" height="255" as="geometry"/>
        </mxCell>
        <mxCell id="f0" value="1  Two independent Log Analytics workspaces, not one shared workspace - same reasoning as Lab 16's groups and Lab 17's scaling plans" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#243A5E;fontSize=11;fontColor=#243A5E;verticalAlign=middle;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="500" width="1380" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="f1" value="2  Each workspace receives diagnostics from its own region's host pool only, via its own diagnostic setting resource" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#243A5E;fontSize=11;fontColor=#243A5E;verticalAlign=middle;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="540" width="1380" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="f2" value="3  The dashboard queries both workspaces with cross-workspace(), aggregating for the operator's convenience without merging the underlying data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#243A5E;fontSize=11;fontColor=#243A5E;verticalAlign=middle;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="580" width="1380" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="f3" value="4  If centralus's workspace becomes unreachable, the dashboard shows a GAP for that region specifically, not a total failure" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B77300;fontSize=11;fontColor=#B77300;verticalAlign=middle;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="620" width="1380" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="f4" value="5  Firewall for centralus egress control is OFF by default (var.deploy_firewall = false) - NSG-only egress matches Lab 11's pattern at a fraction of the cost" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#243A5E;fontSize=11;fontColor=#243A5E;verticalAlign=middle;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="660" width="1380" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="foot" value="Original architecture diagram created for this book. Not a Microsoft diagram. Verified against terraform/lab18-regional-security-monitoring, August 2026. Self-contained shapes, no remote icon dependency." style="text;fontSize=10;fontColor=#605E5C;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="735" width="1200" height="20" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
