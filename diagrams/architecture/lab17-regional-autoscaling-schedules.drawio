          <mxGeometry x="60" y="140" width="340" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="Peak, 09:00&#10;BreadthFirst" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#243A5E;fontSize=11;fontColor=#243A5E;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="410" y="140" width="340" height="50" as="geometry"/>
        </mxCell>
