        <mxCell id="zCus" value="CENTRALUS - SP-AVD-LAB-CUS-01 (CENTRAL STANDARD TIME)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3FAF3;strokeColor=#107C10;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;fontSize=11;fontStyle=1;fontColor=#107C10;" vertex="1" parent="1">
          <mxGeometry x="40" y="230" width="1420" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="c1" value="Ramp-up, 06:00&#10;min 60%, threshold 75%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#243A5E;fontSize=11;fontColor=#243A5E;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="270" width="340" height="50" as="geometry"/>
        </mxCell>
