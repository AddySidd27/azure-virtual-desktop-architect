          <mxGeometry x="410" y="270" width="340" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="c3" value="Ramp-down, 17:00&#10;min 15%, wait 45min" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#243A5E;fontSize=11;fontColor=#243A5E;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="760" y="270" width="340" height="50" as="geometry"/>
