        <mxCell id="sub" value="Lab 17 | Matches terraform/lab17-regional-autoscaling exactly | Power Management Autoscale, two independent schedules" style="text;fontSize=12;fontColor=#605E5C;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="55" width="1200" height="20" as="geometry"/>
        </mxCell>
