        <mxCell id="sub" value="Lab 14 | Matches terraform/lab14-active-active-hostpools exactly | standard host-pool management, not Session Host Configuration" style="text;fontSize=12;fontColor=#605E5C;align=left;" vertex="1" parent="1">
