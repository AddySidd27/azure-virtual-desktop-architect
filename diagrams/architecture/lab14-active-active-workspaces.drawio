        <mxCell id="w2" value="ws-avdlab-lab-cus-01&#10;Central US Desktop workspace" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#243A5E;fontSize=11;fontColor=#243A5E;verticalAlign=middle;" vertex="1" parent="1">
