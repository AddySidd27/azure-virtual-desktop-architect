          <mxGeometry x="810" y="260" width="600" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="zFlow" value="FLOWS AND DESIGN NOTES" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#1F5B96;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;fontSize=11;fontStyle=1;fontColor=#1F5B96;" vertex="1" parent="1">
          <mxGeometry x="40" y="420" width="1400" height="255" as="geometry"/>
        </mxCell>
        <mxCell id="f0" value="1  Both host pools are fully independent - not one pool spanning two regions - each with its own workspace and application group" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#243A5E;fontSize=11;fontColor=#243A5E;verticalAlign=middle;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="460" width="1380" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="f1" value="2  A user assigned to BOTH regions' application groups sees TWO desktop entries in Windows App - this is expected active-active behaviour, not a bug" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B77300;fontSize=11;fontColor=#B77300;verticalAlign=middle;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="500" width="1380" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="f2" value="3  Lab 16 prevents that duplicate assignment: each user is assigned to exactly one region's application group at a time" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#243A5E;fontSize=11;fontColor=#243A5E;verticalAlign=middle;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="540" width="1380" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="f3" value="4  Neither host pool uses Session Host Configuration - both use standard management, matching Lab 7/8 exactly (see the ADR)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#243A5E;fontSize=11;fontColor=#243A5E;verticalAlign=middle;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="580" width="1380" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="f4" value="5  Both regions serve real, separate user cohorts simultaneously - this is active-active, not one region on standby for the other (that is Lab 19)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#243A5E;fontSize=11;fontColor=#243A5E;verticalAlign=middle;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="620" width="1380" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="foot" value="Original architecture diagram created for this book. Not a Microsoft diagram. Verified against terraform/lab14-active-active-hostpools, August 2026. Self-contained shapes, no remote icon dependency." style="text;fontSize=10;fontColor=#605E5C;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="695" width="1200" height="20" as="geometry"/>
