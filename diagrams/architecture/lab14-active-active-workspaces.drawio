        <mxCell id="h2" value="hp-avd-lab-cus-01&#10;Pooled, standard management" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#243A5E;fontSize=11;fontColor=#243A5E;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="810" y="140" width="600" height="50" as="geometry"/>
