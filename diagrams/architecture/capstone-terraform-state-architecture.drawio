          <mxGeometry x="1020" y="140" width="420" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="av0" value="host-pools&#10;key supplied at init - applied per region, x2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#B77300;fontSize=11;fontColor=#B77300;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;dashed=1;dashPattern=6 4;" vertex="1" parent="1">
          <mxGeometry x="1020" y="205" width="420" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="av1" value="workspace-appgroups&#10;key supplied at init - applied per region, x2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#B77300;fontSize=11;fontColor=#B77300;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;dashed=1;dashPattern=6 4;" vertex="1" parent="1">
          <mxGeometry x="1020" y="255" width="420" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="av2" value="fslogix&#10;key supplied at init - applied per region, x2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#B77300;fontSize=11;fontColor=#B77300;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;dashed=1;dashPattern=6 4;" vertex="1" parent="1">
          <mxGeometry x="1020" y="305" width="420" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="network-spokes reads platform" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#107C10;strokeWidth=2.2;endArrow=blockThin;endFill=1;fontColor=#107C10;" edge="1" parent="1" source="zLZ" target="zPlat">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="avd-platform reads network-spokes + identity + monitoring" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#B77300;strokeWidth=2.2;endArrow=blockThin;endFill=1;fontColor=#B77300;" edge="1" parent="1" source="zAvd" target="zLZ">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="zFlow" value="HOW TO READ THIS IN 60 SECONDS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#1F5B96;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;fontSize=12;fontStyle=1;fontColor=#1F5B96;" vertex="1" parent="1">
          <mxGeometry x="40" y="580" width="1420" height="255" as="geometry"/>
        </mxCell>
        <mxCell id="f0" value="1  Zero backend.tf files existed anywhere before this part - every cross-module wire-up was manual tfvars copy-paste, not the terraform_remote_state pattern Labs 11-20 already proved." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#243A5E;fontSize=10.5;fontColor=#243A5E;verticalAlign=middle;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="620" width="1380" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="f1" value="2  Three backends, not one and not fourteen - one per layer, respecting the exact platform/workload ownership boundary maintained since Part A." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#107C10;fontSize=10.5;fontColor=#107C10;verticalAlign=middle;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="660" width="1380" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="f2" value="3  host-pools, workspace-appgroups, and fslogix use PARTIAL backend config - applied twice per region from identical code, so the state key must be supplied at init time, never hardcoded." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B77300;fontSize=10.5;fontColor=#B77300;verticalAlign=middle;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="700" width="1380" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="f3" value="4  A real error caught during this part's own build: workspace-appgroups -> host-pools was first mislabeled cross-layer. It's within avd-platform. The genuine cross-layer read (network-spokes) had been missed and is now fixed." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B77300;fontSize=10.5;fontColor=#B77300;verticalAlign=middle;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="740" width="1380" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="f4" value="5  Within-platform-layer references (rbac -> security, finops -> subscriptions) remain manual - a disclosed, unconverted item, not claimed done." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#605E5C;fontSize=10.5;fontColor=#605E5C;verticalAlign=middle;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="780" width="1380" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="foot" value="Original architecture diagram for this capstone, not Microsoft's. Verified against terraform/capstone-northwind and Part G, August 2026. Self-contained, no remote icon dependency." style="text;fontSize=10;fontColor=#605E5C;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="850" width="1400" height="20" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
