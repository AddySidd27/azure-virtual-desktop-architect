        <mxCell id="zAvd" value="AVD PLATFORM BACKEND (PARTIAL CONFIG)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF6EC;strokeColor=#B77300;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;fontSize=12;fontStyle=1;fontColor=#B77300;" vertex="1" parent="1">
