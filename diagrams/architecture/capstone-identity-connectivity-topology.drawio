<mxfile host="app.diagrams.net" agent="azure-virtual-desktop-architect">
  <diagram name="Capstone Part C Identity Connectivity" id="capstonec">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" page="1" pageWidth="1500" pageHeight="860" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Northwind Identity and Connectivity Foundation: architecture at a glance" style="text;fontSize=20;fontStyle=1;fontColor=#243A5E;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1200" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="sub" value="Capstone Part C | Two regional hubs, four domain controllers, hybrid identity - Bangalore explicitly out of scope for this part" style="text;fontSize=12;fontColor=#605E5C;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="55" width="1300" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="chicago" value="Chicago&#10;On-premises AD forest, ExpressRoute" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#243A5E;fontSize=13;fontColor=#243A5E;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="300" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="bangalore" value="Bangalore&#10;No ExpressRoute - out of scope, Part C sec. 6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#605E5C;fontSize=13;fontColor=#605E5C;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
