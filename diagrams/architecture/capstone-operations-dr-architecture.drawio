        <mxCell id="rv3" value="Designed only, no Terraform (Part F16)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B77300;fontSize=11;fontColor=#B77300;verticalAlign=middle;align=left;spacingLeft=8;dashed=1;dashPattern=6 4;" vertex="1" parent="1">
