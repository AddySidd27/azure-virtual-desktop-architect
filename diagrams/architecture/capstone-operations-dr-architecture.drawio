        <mxCell id="rl4" value="FSLogix data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#243A5E;fontSize=11;fontColor=#243A5E;verticalAlign=middle;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="90" y="780" width="380" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="rv4" value="Azure Backup exists - restore never tested" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#107C10;fontSize=11;fontColor=#107C10;verticalAlign=middle;align=left;spacingLeft=8;" vertex="1" parent="1">
