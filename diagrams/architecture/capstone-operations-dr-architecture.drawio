        <mxCell id="t5" value="Two independently active regions + cross-region FSLogix redundancy (Parts E/F, unchanged)&#10;Real, built - but NOT disaster recovery, see below" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#107C10;fontSize=11;fontColor=#107C10;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="90" y="215" width="1340" height="55" as="geometry"/>
