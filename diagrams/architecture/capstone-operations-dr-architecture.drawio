  <diagram name="Capstone Part H Operations DR" id="capstoneh">
    <mxGraphModel dx="1600" dy="1300" grid="1" gridSize="10" guides="1" page="1" pageWidth="1500" pageHeight="1130" math="0" shadow="0">
      <root>
