        <mxCell id="zGap" value="DESIGNED ONLY - NO TERRAFORM EXISTS ANYWHERE (THE CENTRAL PART H FINDING)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF6EC;strokeColor=#B77300;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;fontSize=12;fontStyle=1;fontColor=#B77300;" vertex="1" parent="1">
          <mxGeometry x="60" y="330" width="1380" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="g1" value="Active-passive cross-region failover&#10;For ANY of the five personas, in EITHER direction: no warm-standby host pool, no reserved capacity, no workspace reassignment, no rehearsed runbook. Lab 19's proven pattern exists - not applied here yet." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#B77300;fontSize=11;fontColor=#B77300;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;dashed=1;dashPattern=6 4;" vertex="1" parent="1">
          <mxGeometry x="90" y="370" width="660" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="g2" value="Recommendation: finance-first (ADR-CAP-07)&#10;Smallest pooled persona, highest compliance weight - but CONDITIONAL on Northwind's business and compliance approval. Not built speculatively, not decided by this document alone." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#B77300;fontSize=11;fontColor=#B77300;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;dashed=1;dashPattern=6 4;" vertex="1" parent="1">
