        <mxCell id="zwarn" value="DESTROY ORDER WARNING" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF6F6;strokeColor=#A4262C;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;fontSize=11;fontStyle=1;fontColor=#A4262C;" vertex="1" parent="1"><mxGeometry x="60" y="260" width="1400" height="120" as="geometry"/></mxCell>
        <mxCell id="warntext" value="These modules are NOT linked by terraform_remote_state - every cross-module reference above is a &quot;data&quot; block looking up an existing resource by name.&#10;Terraform's own dependency graph therefore only tracks resources WITHIN one module's state file, not across these arrows.&#10;Destroying lab07 before lab08/09/10 leaves those modules' data sources pointing at a resource that no longer exists.&#10;Destroy order must follow the arrows in reverse: lab10, lab09, lab08, lab07, lab05, lab04, lab03, lab02 - see Lab 10's own cleanup section." style="text;fontSize=11;fontColor=#5C1A1A;align=left;" vertex="1" parent="1"><mxGeometry x="90" y="295" width="1340" height="75" as="geometry"/></mxCell>
