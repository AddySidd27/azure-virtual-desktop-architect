        <mxCell id="e1" value="peer-eus2-to-cus" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#107C10;strokeWidth=3;endArrow=blockThin;endFill=1;fontColor=#107C10;" edge="1" parent="1" source="s2" target="c1">
