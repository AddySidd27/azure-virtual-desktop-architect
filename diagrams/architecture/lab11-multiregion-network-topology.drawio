          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="zFlow" value="FLOWS AND DESIGN NOTES" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#1F5B96;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;fontSize=11;fontStyle=1;fontColor=#1F5B96;" vertex="1" parent="1">
          <mxGeometry x="40" y="460" width="1420" height="255" as="geometry"/>
        </mxCell>
        <mxCell id="f0" value="1  peer-eus2-to-cus and peer-cus-to-eus2: bidirectional VNet peering, not transitive, each direction is its own resource" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#243A5E;fontSize=11;fontColor=#243A5E;verticalAlign=middle;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="500" width="1380" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="f1" value="2  allow_virtual_network_access = true on both sides; allow_gateway_transit and use_remote_gateways = false (no shared gateway in this lab)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#243A5E;fontSize=11;fontColor=#243A5E;verticalAlign=middle;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="540" width="1380" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="f2" value="3  Address spaces do not overlap by design: 10.10.0.0/16 (eastus2) and 10.20.0.0/16 (centralus) - required for peering to succeed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#243A5E;fontSize=11;fontColor=#243A5E;verticalAlign=middle;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="580" width="1380" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="f3" value="4  DNS resolution across regions is NOT configured in this lab - it depends on the centralus domain controller Lab 12 builds" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B77300;fontSize=11;fontColor=#B77300;verticalAlign=middle;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="620" width="1380" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="f4" value="5  nsg-identity-lab-cus-01 adds Allow-AD-Replication-From-Eastus2 (source 10.10.0.0/16), a rule Lab 3's original NSG did not need" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#243A5E;fontSize=11;fontColor=#243A5E;verticalAlign=middle;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="660" width="1380" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="foot" value="Original architecture diagram created for this book. Not a Microsoft diagram. Verified against terraform/lab11-multiregion-network, August 2026. Self-contained shapes, no remote icon dependency." style="text;fontSize=10;fontColor=#605E5C;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="735" width="1200" height="20" as="geometry"/>
        </mxCell>
