<mxfile host="app.diagrams.net" agent="azure-virtual-desktop-architect">
  <diagram name="Capstone Part D Governance Corrected" id="capstoned">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" page="1" pageWidth="1500" pageHeight="1030" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Northwind Governance Control Plane: architecture at a glance" style="text;fontSize=20;fontStyle=1;fontColor=#243A5E;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1100" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="sub" value="Capstone Part D | Policy inheritance, team-boundary RBAC, and the two gaps Part D closes from Part C" style="text;fontSize=12;fontColor=#605E5C;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="55" width="1300" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="root" value="Northwind (Intermediate Root)&#10;3 policies assigned here: tags, regions, diagnostics" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#243A5E;fontSize=13;fontColor=#243A5E;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="420" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="plat" value="Platform subscriptions&#10;Identity, Management, Connectivity - all three inherit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#243A5E;fontSize=13;fontColor=#243A5E;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="185" width="420" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="avdlz" value="Corp -&gt; future AVD subscriptions&#10;Will inherit the same 3 policies automatically, Part E" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#B77300;fontSize=13;fontColor=#B77300;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;dashed=1;dashPattern=6 4;" vertex="1" parent="1">
          <mxGeometry x="60" y="270" width="420" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="inherits automatically" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#243A5E;strokeWidth=2.2;endArrow=blockThin;endFill=1;fontColor=#243A5E;" edge="1" parent="1" source="root" target="plat">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#243A5E;strokeWidth=2.2;endArrow=blockThin;endFill=1;fontColor=#243A5E;" edge="1" parent="1" source="plat" target="avdlz">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="note1" value="Enforced by ARM at creation time - a Deny policy blocks a violating resource before it exists, not by convention someone could skip." style="text;fontSize=11;fontColor=#605E5C;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="335" width="420" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="zRbac" value="RBAC TEAM BOUNDARIES - LEAST PRIVILEGE, NOT ONE BROAD ROLE (PLATFORM/RBAC)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3FAF3;strokeColor=#107C10;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;fontSize=12;fontStyle=1;fontColor=#107C10;" vertex="1" parent="1">
          <mxGeometry x="560" y="100" width="900" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="r1" value="Platform Engineer&#10;Northwind MG - PIM-eligible" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#243A5E;fontSize=13;fontColor=#243A5E;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="590" y="140" width="260" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="r2" value="Identity Administrator&#10;sub-northwind-identity only - PIM-eligible" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#243A5E;fontSize=13;fontColor=#243A5E;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="870" y="140" width="260" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="r3" value="Network Administrator&#10;sub-northwind-connectivity only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#243A5E;fontSize=13;fontColor=#243A5E;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1150" y="140" width="280" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="r4" value="Security Reader&#10;Tenant root, read-only - STANDING" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#107C10;fontSize=13;fontColor=#107C10;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="590" y="210" width="260" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="r5" value="Security Administrator&#10;Policy exemptions only - PIM-eligible" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#243A5E;fontSize=13;fontColor=#243A5E;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="870" y="210" width="260" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="r6" value="AVD / Ops (future)&#10;Not defined yet - Part E/F's job" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#605E5C;fontSize=13;fontColor=#605E5C;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;dashed=1;dashPattern=6 4;" vertex="1" parent="1">
          <mxGeometry x="1150" y="210" width="280" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="corr" value="CORRECTED: all six roles above are built in platform/rbac/, not platform/security/ - moved here during the PIM remediation pass (see the implementation tracker)." style="text;fontSize=10.5;fontColor=#107C10;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="576" y="325" width="860" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="zGaps" value="GAPS PART D CLOSES FROM PART C'S BUILD (PLATFORM/SECURITY)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF6EC;strokeColor=#B77300;strokeWidth=1.8;verticalAlign=top;align=left;spacingLeft=10;fontSize=12;fontStyle=1;fontColor=#B77300;" vertex="1" parent="1">
          <mxGeometry x="60" y="400" width="1380" height="175" as="geometry"/>
        </mxCell>
        <mxCell id="kv" value="Key Vault (kv-northwind-platform)&#10;DC admin credentials + Connect Sync service account now live here - RBAC-authorized, Private Endpoint only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#107C10;fontSize=13;fontColor=#107C10;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="90" y="440" width="650" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="bastion" value="Azure Bastion Premium x2&#10;Session recording (Premium-only, per Microsoft Learn) for privileged access to Part C's domain controllers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#107C10;fontSize=13;fontColor=#107C10;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="760" y="440" width="650" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="zBg" value="BREAK-GLASS - THE ONE CONTROL THIS DESIGN DOES NOT FULLY CLOSE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF3F3;strokeColor=#A4262C;strokeWidth=1.8;verticalAlign=top;align=left;spacingLeft=10;fontSize=12;fontStyle=1;fontColor=#A4262C;" vertex="1" parent="1">
          <mxGeometry x="60" y="605" width="1380" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="bg" value="2 cloud-only Global Admin accounts, standing (not PIM), excluded from Conditional Access&#10;Credentials must be split OFFLINE, not just stored in the Key Vault above" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#A4262C;fontSize=13;fontColor=#A4262C;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="90" y="645" width="1320" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="zFlow" value="HOW TO READ THIS IN 60 SECONDS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#1F5B96;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;fontSize=12;fontStyle=1;fontColor=#1F5B96;" vertex="1" parent="1">
          <mxGeometry x="40" y="735" width="1420" height="255" as="geometry"/>
        </mxCell>
        <mxCell id="f0" value="1  Policy inheritance is automatic and ARM-enforced - Part E's future AVD subscriptions get all 3 Part B policies with zero new policy work required." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#243A5E;fontSize=11;fontColor=#243A5E;verticalAlign=middle;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="775" width="1380" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="f1" value="2  RBAC is split by team, not one broad Platform role - Identity and Network administrators have no reason to touch each other's infrastructure." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#243A5E;fontSize=11;fontColor=#243A5E;verticalAlign=middle;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="815" width="1380" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="f2" value="3  A genuine, disclosed tension: break-glass credentials living in Key Vault depend on the same Entra ID that might be degraded when break-glass is actually needed." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A4262C;fontSize=11;fontColor=#A4262C;verticalAlign=middle;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="855" width="1380" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="f3" value="4  Workload/AVD security (session host baselines, watermarking) is deliberately NOT here - Part F's job, once host pools exist to apply a baseline to." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#605E5C;fontSize=11;fontColor=#605E5C;verticalAlign=middle;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="895" width="1380" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="f4" value="5  All RBAC/PIM roles shown above live in platform/rbac/ - not platform/security/, where they were first (incorrectly) built. Corrected during the PIM remediation, and again here in the diagram." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#107C10;fontSize=11;fontColor=#107C10;verticalAlign=middle;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="935" width="1380" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="foot" value="Original architecture diagram for this capstone, not Microsoft's. Verified against terraform/capstone-northwind/platform/security (Key Vault, Bastion, break-glass) and platform/rbac (all RBAC/PIM roles) and Part D, August 2026. Self-contained, no remote icon dependency." style="text;fontSize=10;fontColor=#605E5C;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="985" width="1400" height="20" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
