<mxfile host="app.diagrams.net" agent="azure-virtual-desktop-architect">
  <diagram name="Lab 13 regional storage" id="lab13">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" page="1" pageWidth="1500" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Lab 13 - regional storage topology" style="text;fontSize=20;fontStyle=1;fontColor=#243A5E;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="sub" value="Lab 13 | Matches terraform/lab13-regional-storage exactly | independent storage account, not a replica of Lab 5's" style="text;fontSize=12;fontColor=#605E5C;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="55" width="1200" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="zEus2" value="EASTUS2 (LAB 5, EXISTING)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FC;strokeColor=#0078D4;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;fontSize=11;fontStyle=1;fontColor=#0078D4;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="660" height="260" as="geometry"/>
        </mxCell>
        <mxCell id="s1" value="stfslogixlabeus201&#10;Premium FileStorage, ZRS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#243A5E;fontSize=11;fontColor=#243A5E;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="70" y="140" width="600" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="s2" value="pe-stfslogix-lab-eus2-01&#10;private endpoint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#243A5E;fontSize=11;fontColor=#243A5E;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="70" y="200" width="600" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="s3" value="privatelink.file.core.windows.net&#10;zone scoped to eastus2 storage RG only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#605E5C;fontSize=11;fontColor=#243A5E;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="70" y="260" width="600" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="zCus" value="CENTRALUS (LAB 13, NEW)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3FAF3;strokeColor=#107C10;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;fontSize=11;fontStyle=1;fontColor=#107C10;" vertex="1" parent="1">
          <mxGeometry x="780" y="100" width="660" height="260" as="geometry"/>
        </mxCell>
        <mxCell id="c1" value="stfslogixlabcus01&#10;Premium FileStorage, ZRS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#243A5E;fontSize=11;fontColor=#243A5E;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="810" y="140" width="600" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="c2" value="pe-stfslogix-lab-cus-01&#10;private endpoint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#243A5E;fontSize=11;fontColor=#243A5E;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="810" y="200" width="600" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="c3" value="privatelink.file.core.windows.net&#10;separate zone, scoped to centralus storage RG only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#605E5C;fontSize=11;fontColor=#243A5E;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="810" y="260" width="600" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="zFlow" value="FLOWS, IN ORDER" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#1F5B96;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;fontSize=11;fontStyle=1;fontColor=#1F5B96;" vertex="1" parent="1">
          <mxGeometry x="40" y="400" width="1400" height="255" as="geometry"/>
        </mxCell>
        <mxCell id="f0" value="1  Two independent storage accounts, not a replica pair - each has its own private endpoint and its own DNS zone" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#243A5E;fontSize=11;fontColor=#243A5E;verticalAlign=middle;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="440" width="1360" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="f1" value="2  Zone names are identical (privatelink.file.core.windows.net) but the zones themselves are separate Azure resources, one per region" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#243A5E;fontSize=11;fontColor=#243A5E;verticalAlign=middle;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="480" width="1360" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="f2" value="3  A centralus session host resolves stfslogixlabcus01 through the centralus zone only - it has no DNS path to the eastus2 zone" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#243A5E;fontSize=11;fontColor=#243A5E;verticalAlign=middle;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="520" width="1360" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="f3" value="4  Cross-region profile replication is NOT DNS-based - Lab 15 configures FSLogix Cloud Cache to replicate data between the two accounts directly" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B77300;fontSize=11;fontColor=#B77300;verticalAlign=middle;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="560" width="1360" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="f4" value="5  Share-level RBAC (Storage File Data SMB Share Contributor) granted to the same Entra group as Lab 5, since Lab 15's replicated profiles need consistent access in both regions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#243A5E;fontSize=11;fontColor=#243A5E;verticalAlign=middle;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="600" width="1360" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="foot" value="Original architecture diagram created for this book. Not a Microsoft diagram. Verified against terraform/lab13-regional-storage, August 2026. Self-contained shapes, no remote icon dependency." style="text;fontSize=10;fontColor=#605E5C;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="675" width="1200" height="20" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
