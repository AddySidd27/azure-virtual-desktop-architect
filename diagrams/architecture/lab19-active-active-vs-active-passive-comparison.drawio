<mxfile host="app.diagrams.net" agent="azure-virtual-desktop-architect">
  <diagram name="Lab 19 comparison" id="lab19b">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" page="1" pageWidth="1500" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Lab 14 vs Lab 19 - active-active compared against active-passive" style="text;fontSize=20;fontStyle=1;fontColor=#243A5E;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1000" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="sub" value="These are different patterns solving different problems - not one being a correction of the other" style="text;fontSize=12;fontColor=#605E5C;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="55" width="1100" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="z14" value="LAB 14 - ACTIVE-ACTIVE (CENTRALUS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3FAF3;strokeColor=#107C10;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;fontSize=11;fontStyle=1;fontColor=#107C10;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="660" height="300" as="geometry"/>
        </mxCell>
        <mxCell id="r1" value="RTO&#10;Near-zero - no admin intervention needed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#107C10;fontSize=11;fontColor=#243A5E;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="70" y="140" width="600" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="r2" value="Steady-state cost&#10;High - dual compute, dual storage, always on" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#A4262C;fontSize=11;fontColor=#243A5E;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="70" y="200" width="600" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="r3" value="User experience&#10;Duplicate feed by design, two labelled desktops" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#243A5E;fontSize=11;fontColor=#243A5E;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="70" y="260" width="600" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="r4" value="Activation&#10;None needed - both regions already serving users" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#107C10;fontSize=11;fontColor=#243A5E;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="70" y="320" width="600" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="z19" value="LAB 19 - ACTIVE-PASSIVE (WESTUS2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF6EC;strokeColor=#B77300;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;fontSize=11;fontStyle=1;fontColor=#B77300;" vertex="1" parent="1">
          <mxGeometry x="780" y="100" width="660" height="300" as="geometry"/>
        </mxCell>
        <mxCell id="p1" value="RTO&#10;15-60 minutes - admin-triggered failover runbook" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#B77300;fontSize=11;fontColor=#243A5E;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="810" y="140" width="600" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="p2" value="Steady-state cost&#10;Low - deallocated hosts, capacity reservation only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#107C10;fontSize=11;fontColor=#243A5E;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="810" y="200" width="600" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="p3" value="User experience&#10;No duplicate feed - same desktop entry, re-pointed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#243A5E;fontSize=11;fontColor=#243A5E;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="810" y="260" width="600" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="p4" value="Activation&#10;Deliberate, documented, human-triggered failover" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#B77300;fontSize=11;fontColor=#243A5E;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="810" y="320" width="600" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="zFlow" value="WHAT THIS COMPARISON IS ACTUALLY FOR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFD;strokeColor=#1F5B96;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=10;fontSize=11;fontStyle=1;fontColor=#1F5B96;" vertex="1" parent="1">
          <mxGeometry x="40" y="440" width="1400" height="255" as="geometry"/>
        </mxCell>
        <mxCell id="f0" value="1  Same book, same reader, two genuinely different answers to what happens when a region fails - not a better and worse version of one idea" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#243A5E;fontSize=11;fontColor=#243A5E;verticalAlign=middle;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="480" width="1380" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="f1" value="2  Lab 14 costs more every month and recovers with zero delay; Lab 19 costs less every month and recovers with a documented delay" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#243A5E;fontSize=11;fontColor=#243A5E;verticalAlign=middle;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="520" width="1380" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="f2" value="3  Choosing between them is a business decision, how much does downtime cost versus how much does always-on redundancy cost, not a technical one" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#243A5E;fontSize=11;fontColor=#243A5E;verticalAlign=middle;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="560" width="1380" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="f3" value="4  A reader who has built both can defend either choice with real numbers, not just a textbook definition of the pattern" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#243A5E;fontSize=11;fontColor=#243A5E;verticalAlign=middle;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="600" width="1380" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="foot" value="Original architecture diagram created for this book. Not a Microsoft diagram. RTO and cost figures sourced from Azure Architecture Center BCDR guidance and this lab set's own Terraform. Self-contained shapes, no remote icon dependency." style="text;fontSize=10;fontColor=#605E5C;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="675" width="1300" height="20" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
